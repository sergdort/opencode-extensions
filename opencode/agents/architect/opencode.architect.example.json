{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".opencode/ARCHITECT_INSTRUCTIONS.md"],
  "agent": {
    "plan": {
      "model": "openai/gpt-6-sol",
      "variant": "high",
      "permission": {
        "task": {
          "*": "deny",
          "explore": "allow",
          "oracle": "allow",
          "contrarian": "allow",
          "github-librarian": "allow"
        }
      }
    },
    "architect": {
      "model": "openai/gpt-6-sol",
      "variant": "high"
    },
    "developer": {
      "model": "openai/gpt-6-sol",
      "variant": "high"
    },
    "developer-luna": {
      "model": "openai/gpt-6-luna",
      "variant": "max"
    },
    "oracle": {
      "model": "openai/gpt-6-astra",
      "variant": "xhigh"
    },
    "contrarian": {
      "model": "openai/gpt-6-astra",
      "variant": "xhigh"
    },
    "explore": {
      "model": "openai/gpt-5.6-terra",
      "variant": "low"
    }
  }
